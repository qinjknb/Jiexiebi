<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dofbot_hw_bridge</name>
  <version>1.0.0</version>
  <description>
    DOFBOT Pro 6 轴总线舵机机械臂的实机桥：把 MoveIt 的 FollowJointTrajectory
    轨迹按固定频率通过 USB-TTL 下发给 STM32（二进制协议，CRC16 校验），
    STM32 用 SYNC WRITE 同步驱动 6 个德晟总线舵机；同时发布 /joint_states。
  </description>
  <maintainer email="dofbot@example.com">dofbot</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- reach_test 要读这台臂的 URDF 做运动学 -->
  <exec_depend>dofbot_pro_description</exec_depend>

  <!-- launch 里用到的（只在实机 launch 时才会被拉起） -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
